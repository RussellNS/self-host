# ----------------------------------------------------------------------
# Stage 2: Final Image
# Purpose: Create a minimal production image that only contains Nginx,
#          the compiled module, and the MaxMind databases.
# ----------------------------------------------------------------------
# Use the same base image but in its clean state.
FROM nginx:${IMAGE_VERSION}

# Install only the necessary run-time dependencies for Nginx and GeoIP2.
RUN apk update \
    && apk add --no-cache \
        # MaxMind runtime library (needed for .so module to work)
        libmaxminddb \
        # PCRE library (Nginx core dependency)
        pcre \
    # Clean up the cache to ensure the smallest possible image size.
    && rm -rf /var/cache/apk/*

# Copy the compiled Nginx binary, dynamic module, and GeoIP data from the builder stage.
# The 'make install' step in the builder stage has put all necessary files here.
COPY --from=builder /etc/nginx/GeoIP2 /etc/nginx/GeoIP2
# Copy the recompiled Nginx executable (smaller due to optimization)
COPY --from=builder /usr/sbin/nginx /usr/sbin/nginx
# Copy the dynamic GeoIP2 module (.so file) and other Nginx libraries/files.
COPY --from=builder /usr/lib/nginx /usr/lib/nginx

# Copy default Nginx configuration files (though often a custom one is supplied separately)
COPY --from=builder /etc/nginx/conf.d /etc/nginx/conf.d
COPY --from=builder /etc/nginx/mime.types /etc/nginx/mime.types

# Standard Nginx container configuration
STOPSIGNAL SIGTERM
CMD ["nginx", "-g", "daemon off;"]

