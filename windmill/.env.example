##########           OS - System Settings           ##########
# ------------------------------------------------------------
TZ=US/Central



##########      NGINX - Reverse Proxy Settings      ##########
# ------------------------------------------------------------
# Source:
#   *  https://hub.docker.com/_/nginx
#NGINX_VERSION=1.30.5-alpine
NGINX_VERSION=1.30.6-alpine



##########       WINDMILL - Windmill Settings       ##########
# ------------------------------------------------------------
# Source:
#   *  https://github.com/windmill-labs/windmill/releases
#   *  https://github.com/windmill-labs/windmill/pkgs/container/windmill-extra
#   *  https://github.com/windmill-labs/windmill/pkgs/container/windmill-extra/versions?filters%5Bversion_type%5D=tagged
#
# To rotate logs, set the following variables:
#LOG_MAX_SIZE=10m
#LOG_MAX_FILE=3

#WINDMILL_VERSION=1.823.0
WINDMILL_VERSION=1.848.2

#EXTRAS_VERSION=1.823.0
EXTRAS_VERSION=1.848.2



##########      DATABASE - PostgreSQL Settings      ##########
# ------------------------------------------------------------
# Source:
#   *  https://hub.docker.com/_/postgres
#
# Use this command to generate 'URL safe' random passwords that include:
#   *  Lowercase
#   *  Uppercase
#   *  Numbers
#   *  Special Characters
#
#   *  echo $(tr -dc 'A-Za-z0-9._~!*()^-' < /dev/urandom | head -c 32)
#POSTGRES_VERSION=18.4
POSTGRES_VERSION=18.6
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://postgres:change-me@db/windmill?sslmode=disable



##########          REDIS - Redis Settings          ##########
# ------------------------------------------------------------
# Source:
#   *  https://hub.docker.com/_/redis
#
# Use this command to generate secrets/keys
#   *  uuidgen
#REDIS_VERSION=8.10.1-alpine
REDIS_VERSION=8.10.2-alpine

REDIS_PASS=change-me
