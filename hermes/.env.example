##########           OS - System Settings           ##########
# ------------------------------------------------------------
TZ=US/Central



##########      NGINX - Reverse Proxy Settings      ##########
# ------------------------------------------------------------
# Source:
#   *  https://hub.docker.com/_/nginx
#NGINX_VERSION=1.30.5-alpine
NGINX_VERSION=1.30.6-alpine

MAXMIND_KEY=change-me



##########          HERMES - App Settings           ##########
# ------------------------------------------------------------
# Source:
#   *  https://hub.docker.com/r/nousresearch/hermes-agent/tags
#
# Use this command to generate 'URL safe' random passwords that include:
#   *  Lowercase
#   *  Uppercase
#   *  Numbers
#   *  Special Characters
#
#   *  echo $(tr -dc 'A-Za-z0-9._~!*()^-' < /dev/urandom | head -c 32)
# Use this command to generate secrets/keys
#   *  uuidgen
#        or
#   *  openssl rand -hex 32
#HERMES_VERSION=v0.22.4
HERMES_VERSION=v0.22.5

BASIC_AUTH_USERNAME=change-me
BASIC_AUTH_PASSWORD=change-me
BASIC_AUTH_SECRET=change-me
