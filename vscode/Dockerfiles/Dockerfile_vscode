# -----------------------------------------------------------------------------
# MAINTENANCE NOTE: Why Debian Bookworm vs. Trixie
# -----------------------------------------------------------------------------
# As of 2024-2026, intentionally hard coding to 'bookworm' (Stable).
# Trixie uses newer systemd scripts that attempt to lock /etc/group during
# 'apt install', which fails under Docker's default security profile.
#
# Microsoft's APT repository works for Debian 12 (Bookworm) but there is no
# stable Microsoft APT package for Debian 13 (Trixie). The recommended path on
# Trixie is to install PowerShell via the GitHub universal .deb package
# instead. Attempting to install PowerShell on Trixie via the .deb package also
# hits a dependency problem--it requires libicu74 or older versions, which
# Trixie doesn't provide in the expected form.
#
# Additional note, Microsoft, Docker, and other major vendors don't officially
# support Debian "Testing" until it becomes the "Stable" release.  Currently,
# Trixie is the "Testing" branch.  While it has newer packages (like
# Python 3.12+ or newer GLIBC), it is subject to breaking changes. Bookworm
# is "Stable," meaning security updates are consistent and the build process
# is predictable.
#
# To upgrade this image build from Bookworm to Trixie without using the
# Microsoft repo, use these steps:
#   1)  Remove the RUN commands related to the "Microsoft repo for PowerShell"
#   2)  Add in the RUN commands to install Powershell from .deb download:
#         # Install PowerShell on Trixie via GitHub release (MS apt repo not supported on Trixie)
#         RUN PWSH_VERSION=7.4.6 \
#             && wget -q "https://github.com/PowerShell/PowerShell/releases/download/v${PWSH_VERSION}/powershell_${PWSH_VERSION}-1.deb_amd64.deb" -O /tmp/powershell.deb \
#             && apt-get install -y --no-install-recommends /tmp/powershell.deb \
#             && rm /tmp/powershell.deb
#
# Bookworm EOL: Standard support until June 2026; LTS until 2028.
# Move to Trixie/Debian 13 only once it becomes the 'Stable' release and 
# Microsoft officially supports it in their repos.
# -----------------------------------------------------------------------------
# Use Debian latest as the base image
ARG IMAGE_VERSION
FROM debian:${IMAGE_VERSION}


# -----------------------------------------------------------------------------
# Build Arguments & Environment Variables
# -----------------------------------------------------------------------------
# Avoid prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# -----------------------------------------------------------------------------
# Create a 'policy-rc.d' bypass policy
# -----------------------------------------------------------------------------
# In a standard Debian OS, when a package like ssh is installed, it calls a
# script to start the service. In Docker, there is no "system init" running
# during the build phase, so the script fails.
#
# The RUN below Prevents services from starting during the build, and breaking
# the build.

#RUN apt-get update && \
    # This prevents services from starting during the install process

# -----------------------------------------------------------------------------
# Install Dependencies
# -----------------------------------------------------------------------------
# Install optional & required packages (without software-properties-common as it's no more available in Trixie)
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        # Required
        curl \
        wget \
        apt-transport-https \
        gnupg2 \
        # Optional
        openssh-client \
        nano \
        net-tools \
        iputils-ping \
        netcat-traditional \
        sudo \
        build-essential \
        gnupg \
        ca-certificates \
        lsb-release \
        unzip \
        git \
        jq \
        socat \
        dos2unix \
    && apt-get clean \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*


