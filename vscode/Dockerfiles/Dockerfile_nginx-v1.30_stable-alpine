# ----------------------------------------------------------------------
# Stage 3: Final Image
# Purpose: Create a minimal production image that only contains Nginx,
#          the compiled modules, the MaxMind databases, and the
#          CrowdSec Lua bouncer library and its dependencies.
# ----------------------------------------------------------------------
FROM nginx:${IMAGE_VERSION}

# Install only the necessary run-time dependencies for: Nginx, GeoIP2, and Lua.
RUN apk update \
    && apk add --no-cache \
        # MaxMind runtime library (needed for .so module to work)
        libmaxminddb \
        # PCRE library (Nginx core dependency)
         pcre \
        # LuaJIT runtime
        luajit \
        # JSON library required by CrowdSec's Lua bouncer
        lua5.1-cjson \
    # Clean up the cache to ensure the smallest possible image size.
    && rm -rf /var/cache/apk/*

# Copy the compiled Nginx binary, dynamic modules, and GeoIP data from the builder stage.
# The 'make install' step in the builder stage has put all necessary files here.
COPY --from=builder /etc/nginx/GeoIP2 /etc/nginx/GeoIP2
# Copy the recompiled Nginx executable (smaller due to optimization)
COPY --from=builder /usr/sbin/nginx /usr/sbin/nginx
# Copy the dynamic GeoIP2 module (.so file) and other Nginx libraries/files.
# NOTE: This picks up ngx_http_geoip2_module.so, ndk_http_module.so, and
#       ngx_http_lua_module.so automatically, since the whole directory is copied.
COPY --from=builder /usr/lib/nginx /usr/lib/nginx

# Copy default Nginx configuration files (though often a custom one is supplied separately)
COPY --from=builder /etc/nginx/conf.d /etc/nginx/conf.d
COPY --from=builder /etc/nginx/mime.types /etc/nginx/mime.types

# Copies the CrowdSec Lua bouncer library files:
#   *  lib/crowdsec.lua
#   *  lib/plugins/crowdsec/*.lua
# repo into /usr/local/lua/, matching the require "plugins.crowdsec.*" paths.
COPY --from=crowdsec-lua /lua-cs-bouncer/lib/. /usr/local/lua/

# Copies the CrowdSec ban/captcha HTML templates
COPY --from=crowdsec-lua /lua-cs-bouncer/templates /var/lib/crowdsec/lua/templates

# Copies the 'lua-resty-http' files
COPY --from=builder /media/lua-resty-http/lib/resty /usr/local/lua/resty

# Copies the 'lua-resty-string' files
COPY --from=builder /media/lua-resty-string/lib/resty/string.lua /usr/local/lua/resty/string.lua

# Copies the 'lua-resty-core' files
COPY --from=builder /media/lua-resty-core/lib/resty/core.lua /usr/local/lua/resty/core.lua
COPY --from=builder /media/lua-resty-core/lib/resty/core /usr/local/lua/resty/core
COPY --from=builder /media/lua-resty-core/lib/ngx /usr/local/lua/ngx

# Copies the 'lua-resty-lrucache' files
COPY --from=builder /media/lua-resty-lrucache/lib/resty/lrucache.lua /usr/local/lua/resty/lrucache.lua
COPY --from=builder /media/lua-resty-lrucache/lib/resty/lrucache /usr/local/lua/resty/lrucache

# Standard Nginx container configuration
STOPSIGNAL SIGTERM
CMD ["nginx", "-g", "daemon off;"]
