##########           OS - System Settings           ##########
# ------------------------------------------------------------
TZ=US/Central



##########      NGINX - Reverse Proxy Settings      ##########
# ------------------------------------------------------------
# Source:
#   *  https://hub.docker.com/_/nginx
#   *  https://hub.docker.com/r/crowdsecurity/lua-bouncer-plugin/tags
#NGINX_VERSION=1.30.5-alpine
NGINX_VERSION=1.30.6-alpine

#LUA_BOUNCER_VERSION=v1.1.1
LUA_BOUNCER_VERSION=v1.1.2

MAXMIND_KEY=change-me



##########       Log API - Log Query Server         ##########
# ------------------------------------------------------------
# Source:
#   *  https://hub.docker.com/_/python
#
# Use this command to generate secrets/keys
#   *  uuidgen
#PYTHON_VERSION=3.15.1-slim-trixie
PYTHON_VERSION=3.15.2-slim-trixie

LOG_API_TOKEN=change-me


##########        CROWDSEC - Agent Settings         ##########
# ------------------------------------------------------------
# Source:
#   *  https://hub.docker.com/r/crowdsecurity/crowdsec/tags
#
# Use this command to generate secrets/keys
#   *  uuidgen
#CROWDSEC_VERSION=v1.8.1
CROWDSEC_VERSION=v1.8.2

AGENT_USERNAME=change-me
AGENT_PASSWORD=change-me



##########         NEXTCLOUD - Web Settings         ##########
# ------------------------------------------------------------
# Source:
#   *  https://hub.docker.com/_/nextcloud
#NEXTCLOUD_VERSION=35.0.1-apache
NEXTCLOUD_VERSION=35.0.2-apache



