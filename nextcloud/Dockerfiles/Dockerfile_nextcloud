ARG IMAGE_VERSION
FROM nextcloud:${IMAGE_VERSION}

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        nano \
        jq \
    && rm -rf /var/lib/apt/lists/*

# Use a2enmod to enable all required modules at once.
RUN a2enmod \
    env \
    headers \
    http2 \
    proxy \
    proxy_http \
    rewrite \
    socache_shmcb \
    ssl
