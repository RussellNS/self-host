# If you just change the port or add more ports here, you will likely also
# have to change the VirtualHost statement in
# /etc/apache2/sites-enabled/000-default.conf

#Listen 80

<IfModule ssl_module>
	Listen 443

	# SSL Protocol support:
	# Enable/disable the protocol levels with which clients will be able to
	# connect.  Syntax is:
	#   *  [+|-]protocol
	# Available 'protocol's:
	#   *  all      Shortcut for all protocols
	#   *  SSLv3    This is the Secure Sockets Layer (SSL) protocol, version 3.0
	#   *  TLSv1    This is the Transport Layer Security (TLS) protocol, v1.0
	#   *  TLSv1.1  This is the Transport Layer Security (TLS) protocol, v1.1
	#   *  TLSv1.2  This is the Transport Layer Security (TLS) protocol, v1.2
	#   *  TLSv1.3  This is the Transport Layer Security (TLS) protocol, v1.3
	# Examples:
	#   Enable everything except SSLv2 and SSLv3
	#     SSLProtocol all -SSLv2 -SSLv3 
	#   Disable everything except TLSv1.2 and TLSv1.3
	#     SSLProtocol -all +TLSv1.3 +TLSv1.2
	SSLProtocol all -SSLv2 -SSLv3 -TLSv1 -TLSv1.1

	# Many ciphers defined here require a modern version (1.0.1+) of OpenSSL. Some
	# require OpenSSL 1.1.0, which as of this writing was in pre-release.
	#SSLCipherSuite      EECDH+AESGCM:EDH+AESGCM
	SSLCipherSuite      ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384:DHE-RSA-CHACHA20-POLY1305
	SSLHonorCipherOrder off
	SSLOpenSSLConfCmd Curves X25519:secp521r1:secp384r1:prime256v1
	SSLCompression      off
	SSLSessionTickets   off

	SSLUseStapling      on
	SSLStaplingCache    "shmcb:logs/stapling-cache(32768)"
</IfModule>

<IfModule mod_gnutls.c>
        Listen 443
</IfModule>

# vim: syntax=apache ts=4 sw=4 sts=4 sr noet
