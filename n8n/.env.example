##########           OS - System Settings           ##########
# List of time zones available:
#   *  https://manpages.ubuntu.com/manpages/plucky/en/man3/DateTime::TimeZone::Catalog.3pm.html
# ------------------------------------------------------------
TZ=US/Central



##########           N8N - App Settings             ##########
# ------------------------------------------------------------
# Source:
#   *  https://hub.docker.com/r/n8nio/n8n/tags
#
# N8N Environment Variables for Deployment
#   *  https://docs.n8n.io/hosting/configuration/environment-variables/deployment/
#
# Create your own encryption key
#   *  base64 /dev/urandom | head -c50
#N8N_VERSION=1.83.2
N8N_VERSION=2.46.7

N8N_SMTP_USER: change-me
N8N_SMTP_PASS: change-me
N8N_SMTP_SENDER: user@example.com

LICENSE_KEY=change-me

ENCRYPTION_KEY=change-me



##########          REDIS - Redis Settings          ##########
# ------------------------------------------------------------
# Source:
#   *  https://hub.docker.com/_/redis
#
# Use this command to generate secrets/keys
#   *  uuidgen
#REDIS_VERSION=8.10.2-alpine
REDIS_VERSION=8.10.3-alpine

REDIS_PASS=change-me



##########      DATABASE - PostgreSQL Settings      ##########
# ------------------------------------------------------------
# Source:
#   *  https://hub.docker.com/_/postgres
#
# Postgres Environment Variables for Docker
#   *  https://github.com/docker-library/docs/blob/master/postgres/README.md#environment-variables
#
# Use this command to generate 'URL safe' random passwords that include:
#   *  Lowercase
#   *  Uppercase
#   *  Numbers
#   *  Special Characters
#
#   *  echo $(tr -dc 'A-Za-z0-9._~!*()^-' < /dev/urandom | head -c 32)
#POSTGRES_VERSION=18.4
POSTGRES_VERSION=18.6

DB_NAME=n8n_db
DB_USER=change-me
DB_PASS=change-me

DB_NON_ROOT_USER=change-me
DB_NON_ROOT_PASS=change-me

