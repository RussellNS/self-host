##########################  OS - Environment Settings  #########################
# List of time zones available:
#   *  https://manpages.ubuntu.com/manpages/plucky/en/man3/DateTime::TimeZone::Catalog.3pm.html
TZ=US/Central



###########################  DB - Postgres Settings  ###########################
# Postgres Environment Variables for Docker
#   *  https://github.com/docker-library/docs/blob/master/postgres/README.md#environment-variables

DB_NAME=n8n

DB_ROOT_USER=change-me
DB_ROOT_PASS=change-me

DB_NON_ROOT_USER=change-me
DB_NON_ROOT_PASS=change-me



#############################  N8N - DB Settings  ##############################
# N8N Environment Variables for Databases
#   *  https://docs.n8n.io/hosting/configuration/environment-variables/database/
DB_TYPE=postgresdb
DB_HOST=n8n_db
DB_PORT=5432



#############################  N8N - App Settings  #############################
# N8N Environment Variables for Deployment
#   *  https://docs.n8n.io/hosting/configuration/environment-variables/deployment/

# Create your own encryption key
#   *  base64 /dev/urandom | head -c50
ENCRYPTION_KEY=change-me



#############################  N8N - Web Settings  #############################
# N8N Environment Variables for Deployment
#   *  https://docs.n8n.io/hosting/configuration/environment-variables/deployment/

N8N_PROTOCOL=https
N8N_HOST=n8n.example.com
N8N_PORT=443

N8N_SECURE_COOKIE=false



#############################  N8N - TLS Settings  #############################
# N8N Environment Variables for Deployment
#   *  https://docs.n8n.io/hosting/configuration/environment-variables/deployment/

N8N_SSL_CERT=/etc/ssl/private/n8n.example.com.fullchain.pem
N8N_SSL_KEY=change-me



#############################  N8N - License Settings  #############################
# N8N Environment Variables for Deployment
#   *  https://docs.n8n.io/hosting/configuration/environment-variables/licenses/

LICENSE_KEY=change-me
