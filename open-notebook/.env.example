##########           OS - System Settings           ##########
# ------------------------------------------------------------
TZ=US/Central



##########      NGINX - Reverse Proxy Settings      ##########
# ------------------------------------------------------------
# Source:
#   *  https://hub.docker.com/_/nginx
#NGINX_VERSION=1.30.4-alpine
NGINX_VERSION=1.30.6-alpine



##########       OPEN NOTEBOOK - App Settings       ##########
# ------------------------------------------------------------
# Source:
#   *  https://hub.docker.com/r/lfnovo/open_notebook/tags
#
# Use this command to generate 'URL safe' random passwords that include:
#   *  Lowercase
#   *  Uppercase
#   *  Numbers
#   *  Special Characters
#
#   *  echo $(tr -dc 'A-Za-z0-9._~!*()^-' < /dev/urandom | head -c 32)
#OPENNOTEBOOK_VERSION=1.14.0
OPENNOTEBOOK_VERSION=1.15.1

OPEN_NOTEBOOK_ENCRYPTION_KEY=change-me


##########      DATABASE - SurrealDB Settings       ##########
# ------------------------------------------------------------
# NOTE: Open Notebook is not yet compatibile with SurrealDB v3+.
#       Stay with v2.
# Source:
#   *  https://hub.docker.com/r/surrealdb/surrealdb/tags
#SURREALDB_VERSION=v2.6.5
SURREALDB_VERSION=v2.6.5
