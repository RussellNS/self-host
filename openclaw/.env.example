##########           OS - System Settings           ##########
# ------------------------------------------------------------
TZ=US/Central



##########      NGINX - Reverse Proxy Settings      ##########
# ------------------------------------------------------------
# Source:
#   *  https://hub.docker.com/_/nginx
#NGINX_VERSION=1.30.5-alpine
NGINX_VERSION=1.30.6-alpine

MAXMIND_KEY=change-me



##########         OPENCLAW - App Settings          ##########
# ------------------------------------------------------------
# Source:
#   *  https://github.com/openclaw/openclaw/releases
#
# Use this command to generate 'URL safe' random passwords that include:
#   *  Lowercase
#   *  Uppercase
#   *  Numbers
#   *  Special Characters
#
#   *  echo $(tr -dc 'A-Za-z0-9._~!*()^-' < /dev/urandom | head -c 32)
#OPENCLAW_VERSION=2026.9.6
OPENCLAW_VERSION=2026.10.3

GATEWAY_TOKEN=change-me
#AUTH_PASSWORD=change-me

# Force Bonjour advertising on (0) or off (1)
DISABLE_BONJOUR=1

# Uncomment and set only if using a cloud model provider instead of/alongside Ollama.
#OPENAI_API_KEY=
#ANTHROPIC_API_KEY=
