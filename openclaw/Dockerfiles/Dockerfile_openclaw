ARG IMAGE_VERSION
FROM ghcr.io/openclaw/openclaw:${IMAGE_VERSION}

USER root

# Install optional packages
RUN apt-get update -y \
    && apt-get install -y --no-install-recommends \
       curl \
       wget \
       jq \
    && apt-get clean \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

USER node
